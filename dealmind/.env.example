# DealMind Production & Local Environment Variables Template

# Frontend Environment Variables (Set on Vercel)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_API_URL=https://your-production-backend.onrender.com
BACKEND_URL=https://your-production-backend.onrender.com

# Backend Environment Variables (Set on Render / Railway / Cloud Provider)
PORT=8000
ENVIRONMENT=production
CORS_ORIGINS=https://frontend-liard-ten-36.vercel.app,http://localhost:3000,http://127.0.0.1:3000

# Supabase Database Credentials (Server-side ONLY)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Hindsight Long-Term Memory Service Credentials
HINDSIGHT_BASE_URL=https://api.hindsight.ai/v1
HINDSIGHT_API_KEY=your_hindsight_api_key_here

# AI Model Provider Credentials (Server-side ONLY)
GEMINI_API_KEY=your_gemini_api_key_here
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
LLM_MODEL=gemini-1.5-pro
